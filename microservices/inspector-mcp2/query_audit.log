{"ts":"2026-08-07T01:18:19.006Z","rejected":false,"sql":"WITH d AS (\n  SELECT id, name, phone, REGEXP_REPLACE(phone,'[^0-9]','') AS digits\n  FROM patients WHERE phone IS NOT NULL AND phone <> ''\n),\nc AS (\n  SELECT id, name, phone, digits,\n    CASE WHEN LENGTH(digits) IN (12,13) AND LEFT(digits,2)='55' THEN SUBSTRING(digits,3)\n         ELSE digits END AS core\n  FROM d\n),\nk AS (\n  SELECT id, name, phone, digits, core,\n    CASE WHEN LENGTH(core) IN (10,11) THEN CONCAT(LEFT(core,2), RIGHT(core,8))\n         WHEN LENGTH(core) IN (8,9) THEN CONCAT('NODDD_', RIGHT(core,8))\n         ELSE CONCAT('WEIRD_', core) END AS match_key\n  FROM c\n),\ng AS (\n  SELECT match_key, COUNT(*) cnt FROM k GROUP BY match_key HAVING cnt>1\n)\nSELECT p.id, k.match_key, g.cnt, p.name, p.phone, p.email, p.cpf, p.birth_date,\n  p.ltv, p.cashback_balance, p.created_at, p.updated_at,\n  (SELECT COUNT(*) FROM deals de WHERE de.patient_id=p.id) as n_deals,\n  (SELECT COUNT(*) FROM whatsapp_conversations wc WHERE wc.patient_id=p.id) as n_wa_conv,\n  (SELECT COUNT(*) FROM activities ac WHERE ac.patient_id=p.id) as n_activities,\n  (SELECT COUNT(*) FROM patient_labels pl WHERE pl.patient_id=p.id) as n_labels\nFROM k\nJOIN g ON g.match_key=k.match_key\nJOIN patients p ON p.id=k.id\nORDER BY k.match_key, p.id\nLIMIT 500","rowCount":500}
