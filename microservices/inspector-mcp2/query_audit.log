{"ts":"2026-08-11T17:05:10.400Z","rejected":false,"sql":"WITH norm AS (\n  SELECT id, name, phone,\n    REGEXP_REPLACE(phone, '[^0-9]', '') AS digits\n  FROM patients\n  WHERE phone IS NOT NULL AND phone != ''\n),\nloc AS (\n  SELECT id, name, phone, digits,\n    CASE\n      WHEN LENGTH(digits) IN (12,13) AND LEFT(digits,2) = '55' THEN SUBSTRING(digits,3)\n      ELSE digits\n    END AS local_num\n  FROM norm\n),\nkeyed AS (\n  SELECT id, name, phone, local_num, LENGTH(local_num) AS loclen,\n    CONCAT(LEFT(local_num,2), RIGHT(local_num,8)) AS grp_key\n  FROM loc\n  WHERE LENGTH(local_num) IN (10,11)\n),\ndupgroups AS (\n  SELECT grp_key FROM keyed GROUP BY grp_key HAVING COUNT(DISTINCT loclen) = 2\n)\nSELECT COUNT(DISTINCT k.grp_key) AS grupos, COUNT(*) AS patients_envolvidos\nFROM keyed k JOIN dupgroups d ON k.grp_key = d.grp_key","rowCount":1}
