{"ts":"2026-08-10T16:01:01.779Z","rejected":false,"sql":"WITH digits AS (\n  SELECT id, name, email, phone, REGEXP_REPLACE(phone, '[^0-9]', '') AS d\n  FROM patients WHERE phone IS NOT NULL AND phone <> ''\n),\nparsed AS (\n  SELECT id, name, email, phone, d, LENGTH(d) AS len,\n    CASE\n      WHEN LENGTH(d) IN (12,13) AND LEFT(d,2)='55' THEN SUBSTRING(d,3,2)\n      WHEN LENGTH(d) IN (10,11) THEN LEFT(d,2)\n      ELSE NULL\n    END AS ddd,\n    CASE\n      WHEN LENGTH(d) IN (12,13) AND LEFT(d,2)='55' THEN SUBSTRING(d,5)\n      WHEN LENGTH(d) IN (10,11) THEN SUBSTRING(d,3)\n      ELSE NULL\n    END AS num\n  FROM digits\n),\ncanon AS (\n  SELECT id, name, email, phone, d, len, ddd, num,\n    CASE\n      WHEN LENGTH(num)=9 AND LEFT(num,1)='9' THEN SUBSTRING(num,2)\n      WHEN LENGTH(num)=8 THEN num\n      ELSE NULL\n    END AS canon8\n  FROM parsed\n)\nSELECT ddd, canon8, COUNT(*) AS n, GROUP_CONCAT(id ORDER BY id) AS ids\nFROM canon\nWHERE ddd IS NOT NULL AND canon8 IS NOT NULL\nGROUP BY ddd, canon8\nHAVING COUNT(*) > 1\nORDER BY n DESC\nLIMIT 500","rowCount":289}
