async function findOrCreatePatient(conn, { name, phone, email }) {
  const normPhone = phone ? phone.replace(/[^+\d]/g, '') : null
  if (!normPhone) {
    const [r0] = await conn.query('INSERT INTO patients (name, phone, email) VALUES (?, ?, ?)', [name, normPhone, email || null])
    return r0.insertId
  }
  const lockKey = 'patient_phone:' + normPhone
  await conn.query('SELECT GET_LOCK(?, 10)', [lockKey])
  try {
    const [rows] = await conn.query('SELECT id FROM patients WHERE phone = ?', [normPhone])
    if (rows[0]) return rows[0].id
    const [r] = await conn.query('INSERT INTO patients (name, phone, email) VALUES (?, ?, ?)', [name, normPhone, email || null])
    return r.insertId
  } finally {
    await conn.query('SELECT RELEASE_LOCK(?)', [lockKey]).catch(function(){})
  }
}

app.post('/api/crm/deals', auth, async (req, res) => {
  const conn = await pool.getConnection()
  let lockPhoneTail = null
  try {
    const { title, patientName, phone, email, value, procedimento, pipeline, stageKey, origem, campanha, conjunto, criativo, referrerPatientId, campaignType } = req.body || {}
    if (!patientName) return res.status(400).json({ success: false, error: 'Nome do paciente é obrigatório' })
    if (!phone) return res.status(400).json({ success: false, error: 'Telefone é obrigatório' })
    await conn.beginTransaction()
    const [[pl]] = await conn.query('SELECT id FROM pipelines WHERE slug = ?', [pipeline || 'inbound'])
    const [[stage]] = await conn.query(
      'SELECT id FROM stages WHERE pipeline_id = ? AND (skey = ? OR ? IS NULL) ORDER BY sort LIMIT 1',
      [pl.id, stageKey || null, stageKey || null]
    )
    const isIndicacaoPipeline = (pipeline || 'inbound') === 'indicacao'
    const plataformaFinal = isIndicacaoPipeline ? 'Indicação' : null
    const campanhaFinal = isIndicacaoPipeline ? (campanha || 'Indicação') : (campanha || null)
    const criativoFinal = isIndicacaoPipeline ? (campanha ? (campaignType === 'empresarial' ? campanha : 'Indicação') : 'Indicação') : (criativo || null)
    const patientId = await findOrCreatePatient(conn, { name: patientName, phone, email })
    const phoneDigitsForLock = String(phone || '').replace(/\D/g, '')
    lockPhoneTail = phoneDigitsForLock.slice(-8) || null
    if (lockPhoneTail) {
      await conn.query('SELECT GET_LOCK(?, 10)', ['tintim_phone:' + lockPhoneTail]).catch(function(){})
    }
    const [existingOpenDealsCheck] = await conn.query('SELECT id FROM deals WHERE patient_id = ? AND status = "open"', [patientId])
    if (existingOpenDealsCheck.length > 0) {
      console.warn('[create-deal] paciente ja possui negocio(s) aberto(s), criando mesmo assim (criacao manual)', patientId, existingOpenDealsCheck.map(function(d){ return d.id }))
    }
    const [r] = await conn.query(
      `INSERT INTO deals (patient_id, pipeline_id, stage_id, title, value, procedure_name, origem, campanha, conjunto, criativo, plataforma, owner_name, stage_entered_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NOW())`,
      [patientId, pl.id, stage.id, title || patientName, value || 0, procedimento || null,
       origem || null, campanhaFinal, conjunto || null, criativoFinal, plataformaFinal, req.user.name]
    )
    await conn.query('INSERT INTO stage_history (deal_id, from_stage_id, to_stage_id, changed_by_user_id) VALUES (?, NULL, ?, ?)', [r.insertId, stage.id, req.user.id])
    await conn.query('INSERT INTO activities (deal_id, patient_id, user_id, type, content) VALUES (?, ?, ?, "system", "Negócio criado")', [r.insertId, patientId, req.user.id])
    await conn.commit()
    if (isIndicacaoPipeline && referrerPatientId) { pool.query("INSERT INTO referrals (referrer_patient_id, referred_patient_id, deal_id, status) VALUES (?, ?, ?, 'pendente')", [referrerPatientId, patientId, r.insertId]).catch(function(e){ console.error('[referral-insert]', e.message) }) }
    res.json({ success: true, id: r.insertId })
  } catch (e) {
    await conn.rollback()
    console.error('create deal error', e)
    res.status(500).json({ success: false, error: 'Erro ao criar negócio' })
  } finally {
    if (lockPhoneTail) {
      await conn.query('SELECT RELEASE_LOCK(?)', ['tintim_phone:' + lockPhoneTail]).catch(function(){})
    }
    conn.release()
  }
})

app.post('/api/crm/ui/dashboard/tintim/importar', auth, async (req, res) => {
