async function applyBulkDealChange(conn, deals, field, value, reqUser) {
  let newOwner = null
  let newStage = null
  if (field === 'owner') {
    const [[u]] = await conn.query('SELECT id, name FROM users WHERE id = ? AND active = 1', [value])
    if (!u) { const err = new Error('Usuario invalido'); err.statusCode = 400; throw err }
    newOwner = u
  } else if (field === 'pipeline') {
    const [[pl]] = await conn.query('SELECT id FROM pipelines WHERE slug = ? AND active = 1', [value])
    if (!pl) { const err = new Error('Funil invalido'); err.statusCode = 400; throw err }
    const [[st]] = await conn.query('SELECT id, label, pipeline_id, skey FROM stages WHERE pipeline_id = ? AND active = 1 ORDER BY sort LIMIT 1', [pl.id])
    if (!st) { const err = new Error('Funil sem etapas configuradas'); err.statusCode = 400; throw err }
    newStage = st
  } else if (field === 'stage') {
    const [[st]] = await conn.query('SELECT id, label, pipeline_id, skey FROM stages WHERE id = ? AND active = 1', [value])
    if (!st) { const err = new Error('Etapa invalida'); err.statusCode = 400; throw err }
    newStage = st
  } else {
    const err = new Error('Campo invalido'); err.statusCode = 400; throw err
  }
  let changed = 0
  for (const d of deals) {
    if (field === 'owner') {
      if (d.owner_name === newOwner.name) continue
      await conn.query('UPDATE deals SET owner_name = ?, sdr_user_id = ? WHERE id = ?', [newOwner.name, newOwner.id, d.id])
      await conn.query('INSERT INTO ownership_history (deal_id, from_owner, to_owner, from_user_id, to_user_id, changed_by_user_id) VALUES (?, ?, ?, ?, ?, ?)', [d.id, d.owner_name, newOwner.name, d.sdr_user_id, newOwner.id, reqUser.id])
      await conn.query('INSERT INTO activities (deal_id, patient_id, user_id, type, content) VALUES (?, ?, ?, ?, ?)', [d.id, d.patient_id, reqUser.id, 'owner_change', '[Alteracao em massa] Dono alterado de ' + (d.owner_name || 'Sem dono') + ' para ' + newOwner.name + ' por ' + reqUser.name])
    } else {
      if (d.stage_id === newStage.id) continue
      await conn.query('UPDATE deals SET stage_id = ?, pipeline_id = ?, stage_entered_at = NOW() WHERE id = ?', [newStage.id, newStage.pipeline_id, d.id])
      await conn.query('INSERT INTO stage_history (deal_id, from_stage_id, to_stage_id, changed_by_user_id) VALUES (?, ?, ?, ?)', [d.id, d.stage_id, newStage.id, reqUser.id])
      const lbl = field === 'pipeline' ? ('[Alteracao em massa] Funil alterado, movido para ' + newStage.label + ' por ' + reqUser.name) : ('[Alteracao em massa] Movido para ' + newStage.label + ' por ' + reqUser.name)
      await conn.query('INSERT INTO activities (deal_id, patient_id, user_id, type, content) VALUES (?, ?, ?, ?, ?)', [d.id, d.patient_id, reqUser.id, 'stage_change', lbl])
      if (newStage.pipeline_id === 1) { await syncAgendaFromDealStage(pool, d.id, newStage.skey); }
    }
    changed++
  }
  return changed
}

app.post('/api/crm/deals/bulk-update', auth, async (req, res) => {
  const conn = await pool.getConnection()
  try {
    const { dealIds, field, value } = req.body || {}
    const ids = Array.isArray(dealIds) ? dealIds.map(x => parseInt(x, 10)).filter(x => x) : []
    if (!ids.length) return res.status(400).json({ success: false, error: 'Selecione ao menos um negocio' })
