const DEAL_CARD_SQL = `
  SELECT d.id, d.title, d.value, d.status, d.procedure_name AS procedimento,
         d.origem, d.campanha, d.conjunto, d.criativo, d.ad_name, d.plataforma, d.palavra_chave,
         d.utm_source, d.utm_medium, d.utm_campaign, d.utm_content, d.utm_term, d.ctwa_clid, d.ad_account_name, d.tintim_source_raw,
         d.owner_name, d.add_date, d.stage_entered_at, d.won_date, d.lost_date,
         d.loss_reason, d.tags, d.stage_tag, d.lead_score, d.stage_id, d.pipeline_id,
            d.duplicate_alert,
          d.reopened_lost_lead,
         p.id AS patient_id, p.name AS patient_name, p.phone AS patient_phone, p.email AS patient_email, p.contact_flag AS patient_contact_flag,
         su.name AS sdr_name, cu.name AS closer_name,
         DATEDIFF(NOW(), d.add_date) AS days_open,
      GREATEST(0, DATEDIFF(NOW(), COALESCE(d.stage_entered_at, d.add_date))) AS days_in_stage,
         s.rotting_days
  FROM deals d
  JOIN patients p ON p.id = d.patient_id
  JOIN stages s ON s.id = d.stage_id
  LEFT JOIN users su ON su.id = d.sdr_user_id
  LEFT JOIN users cu ON cu.id = d.closer_user_id
`

async function attachCardExtras(deals) {
  if (deals.length === 0) return deals
  const ids = deals.map(d => d.id)
  const [labelRows] = await pool.query(
    `SELECT dl.deal_id, l.id, l.name, l.color FROM deal_labels dl
     JOIN labels l ON l.id = dl.label_id WHERE dl.deal_id IN (?)`, [ids])
  const [actRows] = await pool.query(
    `SELECT deal_id,
            MIN(CASE WHEN done = 0 AND due_at IS NOT NULL THEN due_at END) AS next_due
     FROM activities WHERE deal_id IN (?) GROUP BY deal_id`, [ids])
  const labelsBy = {}
  labelRows.forEach(r => { (labelsBy[r.deal_id] = labelsBy[r.deal_id] || []).push({ id: r.id, name: r.name, color: r.color }) })
  const nextBy = Object.fromEntries(actRows.map(r => [r.deal_id, r.next_due]))
  const [lastReplyRows] = await pool.query(
    `SELECT wc.deal_id AS deal_id, MAX(wm.created_at) AS last_inbound_at
     FROM whatsapp_conversations wc
     JOIN whatsapp_messages wm ON wm.conversation_id = wc.id
     WHERE wc.deal_id IN (?) AND wm.direction = 'in'
     GROUP BY wc.deal_id`, [ids])
  const lastReplyBy = Object.fromEntries(lastReplyRows.map(r => [r.deal_id, r.last_inbound_at]))
  const now = new Date()
  const endOfToday = new Date(); endOfToday.setHours(23, 59, 59, 999)
  return deals.map(d => {
    const nextDue = nextBy[d.id] || null
    // igual ao Pipedrive: verde = atividade hoje/futura proxima, vermelho = atrasada, cinza = nenhuma
    const activityStatus = !nextDue ? 'none' : (new Date(nextDue) < now ? 'overdue' : (new Date(nextDue) <= endOfToday ? 'today' : 'planned'))
    return maskDealPhone({ ...d, labels: labelsBy[d.id] || [], next_activity_at: nextDue, activity_status: activityStatus, last_inbound_at: lastReplyBy[d.id] || null })
  })
}

