          await conn.rollback()
          return res.status(400).json({ success: false, error: 'Data de fechamento invalida' })
        }
        if (parsedWonDate.getTime() > Date.now() + 60000) {
          await conn.rollback()
          return res.status(400).json({ success: false, error: 'A data de fechamento nao pode ser no futuro' })
        }
        if (deal.add_date && parsedWonDate.getTime() < new Date(deal.add_date).getTime()) {
          wonDateWarning = 'Atencao: a data de fechamento informada e anterior a data de criacao do negocio'
        }
      }
      // procedimento e OBRIGATORIO para registrar a venda
      const finalProcedure = procedimento !== undefined ? procedimento : deal.procedure_name
      if (!finalProcedure || !String(finalProcedure).trim()) {
        await conn.rollback()
        return res.status(400).json({ success: false, error: 'Informe o procedimento para registrar a venda' })
      }
      // guarda: so processa efeitos colaterais (ltv, log, indicacao) na PRIMEIRA vez que o negocio vira ganho
      if (deal.status !== 'won') {
      await conn.query('UPDATE deals SET status = "won", won_date = ? WHERE id = ?', [wonDate ? new Date(wonDate) : new Date(), dealId])
      await conn.query('UPDATE patients SET ltv = ltv + ? WHERE id = ?', [value !== undefined ? value : deal.value, deal.patient_id])
      await conn.query('INSERT INTO activities (deal_id, patient_id, user_id, type, content) VALUES (?, ?, ?, "system", "Negócio ganho 🎉")', [dealId, deal.patient_id, req.user.id])
      // indicacao: se este paciente foi indicado, marca a indicacao como fechada
      await conn.query('UPDATE referrals SET status = "fechou", closed_at = NOW(), deal_id = ? WHERE referred_patient_id = ? AND status = "pendente"', [dealId, deal.patient_id])
        syncSaleToTintim(dealId).catch(function(e){ console.error('[tintim-sale]', e.message) })
    
      } else if (wonDate) {
        // negocio ja estava ganho: permite apenas corrigir a data retroativa de fechamento
        await conn.query('UPDATE deals SET won_date = ? WHERE id = ?', [new Date(wonDate), dealId])
      }
      } else if (status === 'lost') {
      const [activeLossReasons] = await conn.query('SELECT label FROM loss_reasons WHERE active = 1');
      const ALLOWED_LOSS_REASONS = activeLossReasons.map(r => r.label);
      const lrTrim = (lossReason || '').trim();
      const isOutroReason = /^outro:/i.test(lrTrim) && lrTrim.slice(6).trim().length > 0;
      const lrMatches = ALLOWED_LOSS_REASONS.some(r => r.toLowerCase() === lrTrim.toLowerCase());
      if (!lrTrim || !(lrMatches || isOutroReason)) {
        await conn.rollback();
        return res.status(400).json({ success: false, error: 'Selecione um motivo de perda valido (ou informe "Outro: descricao") antes de marcar como Perdido.' });
      }
      await conn.query('UPDATE deals SET status = "lost", lost_date = NOW(), loss_reason = ? WHERE id = ?', [lossReason || null, dealId])
      await conn.query('INSERT INTO activities (deal_id, patient_id, user_id, type, content) VALUES (?, ?, ?, "system", ?)',
        [dealId, deal.patient_id, req.user.id, `Negócio perdido${lossReason ? ' — ' + lossReason : ''}`])
    } else if (status === 'open') {
      await conn.query('UPDATE deals SET status = "open", won_date = NULL, lost_date = NULL, loss_reason = NULL WHERE id = ?', [dealId])
    }
    await conn.commit()
    res.json({ success: true, wonDateWarning, alreadyWon })
  } catch (e) {
    await conn.rollback()
    console.error('update deal error', e)
    res.status(500).json({ success: false, error: 'Erro ao atualizar negócio' })
  } finally {
    conn.release()
  }
})

