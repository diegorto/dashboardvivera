// TASK_STATUS_DOT_HOOK
app.get('/api/crm/board', async (req, res, next) => {
  const originalJson = res.json.bind(res);
  res.json = function(body) {
    (async () => {
      try {
        const [rows] = await pool.query(
          "SELECT deal_id AS deal_id, " +
          "SUM(CASE WHEN due_at < NOW() THEN 1 ELSE 0 END) AS overdue_count, " +
          "SUM(CASE WHEN due_at >= NOW() THEN 1 ELSE 0 END) AS upcoming_count, " +
          "MIN(CASE WHEN due_at < NOW() THEN due_at END) AS earliest_overdue_due, " +
          "MIN(CASE WHEN due_at >= NOW() THEN due_at END) AS earliest_upcoming_due " +
          "FROM activities WHERE done = 0 AND due_at IS NOT NULL AND deal_id IS NOT NULL " +
          "GROUP BY deal_id"
        );
        // NEVER_SCHEDULE_HOOK
        const [neverRows] = await pool.query(
          "SELECT d.id AS deal_id FROM deals d " +
          "JOIN patient_labels pl ON pl.patient_id = d.patient_id " +
          "JOIN labels l ON l.id = pl.label_id AND l.name = 'NUNCA AGENDAR'"
        );
        const neverSet = new Set(neverRows.map(r => r.deal_id));
        const statusMap = {};
        rows.forEach(function(r) {
          statusMap[r.deal_id] = { status: r.overdue_count > 0 ? 'red' : (r.upcoming_count > 0 ? 'green' : null), due: r.overdue_count > 0 ? r.earliest_overdue_due : r.earliest_upcoming_due };
        });
        const seen = new Set();
        const stamp = function(obj) {
          if (!obj || typeof obj !== 'object') return;
          if (seen.has(obj)) return;
          seen.add(obj);
          if (Array.isArray(obj)) { obj.forEach(stamp); return; }
          if (Object.prototype.hasOwnProperty.call(obj, 'stage_tag') && obj.id != null) {
            var st = statusMap[obj.id]; obj.task_status = st ? st.status : null; obj.task_due_at = st ? st.due : null; obj.never_schedule = neverSet.has(obj.id);
          }
          Object.keys(obj).forEach(function(k) { stamp(obj[k]); });
        };
        stamp(body);
      } catch (e) {
        console.error('task_status hook error:', e.message);
      }
      originalJson(body);
    })();
    return res;
  };
  next();
});

app.get('/api/crm/board', auth, async (req, res) => {
  try {
    const slug = req.query.pipeline || 'inbound'
    const [[pipeline]] = await pool.query('SELECT * FROM pipelines WHERE slug = ?', [slug])
    if (!pipeline) return res.status(404).json({ success: false, error: 'Funil não encontrado' })
    const [stages] = await pool.query('SELECT * FROM stages WHERE pipeline_id = ? AND active = 1 ORDER BY sort', [pipeline.id])
    let boardWhere = " WHERE d.pipeline_id = ? AND d.status = \"open\""
    let boardParams = [pipeline.id]
    let [deals] = await pool.query(DEAL_CARD_SQL + boardWhere + ' ORDER BY d.stage_entered_at DESC', boardParams)
    deals = await attachCardExtras(deals)
    const [pipelines] = await pool.query('SELECT slug, name FROM pipelines WHERE active = 1 ORDER BY sort')
    const columns = stages.map(s => ({
      id: s.id, key: s.skey, label: s.label, rottingDays: s.rotting_days,
      deals: deals.filter(d => d.stage_id === s.id),
      totalValue: deals.filter(d => d.stage_id === s.id).reduce((a, d) => a + Number(d.value || 0), 0)
    }))
    res.json({ success: true, pipeline: { slug: pipeline.slug, name: pipeline.name }, pipelines, columns })
  } catch (e) {
    console.error('board error', e)
    res.status(500).json({ success: false, error: 'Erro interno' })
  }
})

