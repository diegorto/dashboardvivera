function maskPhone(phone) {
  let digits = String(phone || '').replace(/\D/g, '')
  if (digits.length < 4) return '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022'
  if (digits.length >= 12 && digits.startsWith('55')) digits = digits.slice(2) // remove DDI Brasil
  const ddd = digits.slice(0, 2)
  const last2 = digits.slice(-2)
  return ddd + ' 9\u2022\u2022\u2022-\u2022\u2022' + last2
}
function maskDealPhone(d) {
  if (d && d.patient_contact_flag === 'problema_bloqueio' && d.patient_phone) {
    return Object.assign({}, d, { patient_phone: maskPhone(d.patient_phone), patient_phone_masked: true })
  }
  return d
}

function capitalizeWord(s) {
  if (!s) return s
  const w = String(s).trim()
  return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()
}

