    res.json({ success: true, updated: changed, total: deals.length })
  } catch (e) {
    try { await conn.rollback() } catch (e2) {}
    console.error('bulk-update deals error', e)
    res.status(e.statusCode || 500).json({ success: false, error: e.statusCode ? e.message : 'Erro ao aplicar alteracao em massa' })
  } finally {
    conn.release()
  }
})

