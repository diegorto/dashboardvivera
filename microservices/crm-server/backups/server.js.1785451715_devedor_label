app.post('/api/crm/auth/first-login-reset', async (req, res) => {
  try {
    const { userId, currentPassword, newPassword, newEmail } = req.body || {}
    if (!userId || !currentPassword || !newPassword || !newEmail) {
      return res.status(400).json({ success: false, error: 'Dados incompletos' })
    }
    if (String(newPassword).length < 4) {
      return res.status(400).json({ success: false, error: 'Senha muito curta' })
    }
    const [rows] = await pool.query('SELECT * FROM users WHERE id = ? AND active = 1', [userId])
    const user = rows[0]
    if (!user || !(await bcrypt.compare(currentPassword, user.password_hash))) {
      return res.status(401).json({ success: false, error: 'Senha atual incorreta' })
    }
    const newHash = await bcrypt.hash(String(newPassword), 10)
    const cleanEmail = String(newEmail).toLowerCase().trim()
    await pool.query('UPDATE users SET password_hash = ?, email = ?, must_reset_password = 0 WHERE id = ?', [newHash, cleanEmail, user.id])
    const updatedUser = { id: user.id, name: user.name, email: cleanEmail, role: user.role }
    res.json({ success: true, token: sign(updatedUser), user: updatedUser })
  } catch (err) {
    if (err.code === 'ER_DUP_ENTRY') {
      return res.status(409).json({ success: false, error: 'E-mail ja esta em uso' })
    }
    console.error('first-login-reset error', err)
    res.status(500).json({ success: false, error: 'Erro interno' })
  }
})

