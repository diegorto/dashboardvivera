      "SELECT id, procedure_name, tags, loss_reason, add_date FROM deals WHERE patient_id = ? AND status = 'lost' ORDER BY add_date DESC LIMIT 3",
      [patientId]
    )
    if (!lostDeals.length) return null
    const dealIds = lostDeals.map(function (d) { return d.id })
    const [notes] = await pool.query(
      "SELECT deal_id, content FROM activities WHERE deal_id IN (?) AND type = 'note' ORDER BY created_at DESC LIMIT 20",
      [dealIds]
    )
    const [callStats] = await pool.query(
      "SELECT deal_id, SUM(CASE WHEN type LIKE '%Liga%' OR type = 'Chamada Realizada' THEN 1 ELSE 0 END) AS tentativas, SUM(CASE WHEN type LIKE '%Atendida%' THEN 1 ELSE 0 END) AS atendidas FROM activities WHERE deal_id IN (?) GROUP BY deal_id",
      [dealIds]
    )
    const dealsInfo = lostDeals.map(function (d) {
      const dealNotes = notes.filter(function (n) { return n.deal_id === d.id }).map(function (n) { return n.content }).join(' | ')
      const stats = callStats.find(function (c) { return c.deal_id === d.id }) || { tentativas: 0, atendidas: 0 }
      let tagsStr = ''
      try {
        const t = JSON.parse(d.tags || '[]')
        tagsStr = Array.isArray(t) ? t.join(', ') : String(d.tags || '')
      } catch (e) { tagsStr = String(d.tags || '') }
      const dataStr = d.add_date ? new Date(d.add_date).toLocaleDateString('pt-BR') : '?'
      return 'Negocio #' + d.id + ' (perdido em ' + dataStr + '): interesse=' + (d.procedure_name || 'nao informado') + '; motivo da perda=' + (d.loss_reason || 'nao informado') + '; tags=' + (tagsStr || 'nenhuma') + '; tentativas de contato=' + (stats.tentativas || 0) + '; ligacoes atendidas=' + (stats.atendidas || 0) + '; notas=' + (dealNotes || 'sem notas')
    }).join('\n')
    const prompt = 'Voce e um assistente de uma clinica odontologica (Vivera Orofacial). Um lead que ja teve negocio(s) PERDIDO(S) no passado voltou a entrar em contato via WhatsApp. Resuma o historico anterior dele(a) em portugues, de forma curta (3 a 5 frases), destacando: interesse/procedimento, motivo da perda anterior, nivel de engajamento (tentativas e ligacoes atendidas) e qualquer informacao relevante das notas, para ajudar o time comercial a retomar o atendimento com contexto. Use apenas as informacoes fornecidas no historico abaixo; nao invente nomes, lugares, valores ou detalhes que nao estejam explicitamente nele.\n\nHistorico:\n' + dealsInfo + '\n\nResumo:'
    const resp = await axios.post('https://api.openai.com/v1/chat/completions', {
      model: process.env.OPENAI_MODEL || 'gpt-4o-mini',
      messages: [{ role: 'user', content: prompt }],
      temperature: 0.5
    }, {
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + process.env.OPENAI_API_KEY },
      timeout: 20000
    })
    const summary = resp.data && resp.data.choices && resp.data.choices[0] && resp.data.choices[0].message && resp.data.choices[0].message.content
    return summary ? summary.trim() : null
  } catch (e) {
    console.error('[reopened-lost-lead-ai-summary]', e.message)
    return null
  }
}


async function autoResolveDealAdName(dealId, rawCriativo) {
  try {
    if (!dealId || !rawCriativo) return
    const idStr = String(rawCriativo)
    if (!/^[0-9]{10,}$/.test(idStr)) return
    const nameMap = await metaAdsService.resolveAdNames([idStr])
    const resolved = nameMap && nameMap[idStr]
    const finalName = resolved || ('Anuncio ' + idStr + ' (nao encontrado no Meta)')
    await pool.query('UPDATE deals SET ad_name = ? WHERE id = ?', [finalName, dealId])
    console.log('[tintim-webhook] ad_name resolvido deal=' + dealId + ' -> ' + finalName)
  } catch (e) {
    console.error('[tintim-webhook] autoResolveDealAdName erro deal=' + dealId, e.message)
  }
}

