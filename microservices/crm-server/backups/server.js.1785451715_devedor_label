    let origem = null;
    if (source === 'Meta Ads') origem = 'Instagram';
    else if (source === 'Google Ads') origem = 'Google';

    await conn.beginTransaction();
    const [[pl]] = await conn.query('SELECT id FROM pipelines WHERE slug = ?', ['inbound']);
