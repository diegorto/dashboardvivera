const AGENDA_EVENT_STATUS_BY_STAGE_SKEY = { agendamento: 'scheduled', comparecimento: 'attended', 'nao-compareceu': 'no_show', cancelou: 'cancelled' };
async function syncAgendaFromDealStage(pool, dealId, stageSkey) {
  try {
    const targetStatus = AGENDA_EVENT_STATUS_BY_STAGE_SKEY[stageSkey];
    if (!targetStatus || !dealId) return;
    const [[event]] = await pool.query('SELECT id, status FROM calendar_events WHERE deal_id = ? ORDER BY id DESC LIMIT 1', [dealId]);
    if (!event || event.status === targetStatus) return;
    await pool.query('UPDATE calendar_events SET status = ? WHERE id = ?', [targetStatus, event.id]);
    console.log('[dealsync] syncAgendaFromDealStage: deal ' + dealId + ' -> evento ' + event.id + ' status ' + targetStatus);
  } catch (e) {
    console.error('syncAgendaFromDealStage error', e);
  }
}

