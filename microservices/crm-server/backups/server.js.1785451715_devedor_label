function togglePhoneNinthDigit(phone) {
  const ddi = phone.slice(0,2), ddd = phone.slice(2,4), num = phone.slice(4)
  if (num.length === 9 && num[0] === '9') return ddi + ddd + num.slice(1)
  if (num.length === 8) return ddi + ddd + '9' + num
  return null
}

async function tintimStatusPost(phone, payload) {
  const url = 'https://s.tintim.app/api/v1/' + process.env.TINTIM_ACCOUNT_CODE + '/lead/' + phone + '/status?token=' + process.env.TINTIM_ACCOUNT_TOKEN
  const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
  const text = await r.text()
  return { ok: r.ok, status: r.status, text: text }
}

async function syncSaleToTintim(dealId) {
  if (!process.env.TINTIM_ACCOUNT_CODE || !process.env.TINTIM_ACCOUNT_TOKEN) return
  const [[row]] = await pool.query(
    'SELECT d.id, d.value, d.won_date, d.tintim_sale_synced_at, p.phone FROM deals d JOIN patients p ON p.id = d.patient_id WHERE d.id = ?',
    [dealId]
  )
  if (!row || row.tintim_sale_synced_at) return
  if (!row.phone) { console.error('[tintim-sale] sem telefone, deal', dealId); return }
  let phone = String(row.phone).replace(/\D/g, '')
  if (phone.length <= 11) phone = '55' + phone
  const statusId = process.env.TINTIM_STATUS_COMPROU_ID
  if (!statusId) { console.error('[tintim-sale] TINTIM_STATUS_COMPROU_ID nao configurado'); return }
  const saleDatetime = (row.won_date ? new Date(row.won_date) : new Date()).toISOString().slice(0, 19)
  const payload = { id: Number(statusId), sale_amount: Number(row.value || 0), sale_datetime: saleDatetime }
  let result = null
  try {
    result = await tintimStatusPost(phone, payload)
    if (!result.ok) {
      const alt = togglePhoneNinthDigit(phone)
      if (alt) {
        const retryResult = await tintimStatusPost(alt, payload)
        if (retryResult.ok) { result = retryResult; phone = alt }
      }
    }
  } catch (e) {
    result = { ok: false, status: null, text: e.message }
  }
  const success = result && result.ok ? 1 : 0
  if (success) {
    await pool.query('UPDATE deals SET tintim_sale_synced_at = NOW() WHERE id = ?', [dealId])
  } else {
    console.error('[tintim-sale] falhou', dealId, result && result.status, result && result.text)
  }
  await pool.query(
    'INSERT INTO conversion_dispatch_log (deal_id, destino, payload, http_status, response, success) VALUES (?, "tintim", ?, ?, ?, ?)',
    [dealId, JSON.stringify(payload), result ? result.status : null, (result ? String(result.text).slice(0, 2000) : ''), success]
  ).catch(function(){})
}


