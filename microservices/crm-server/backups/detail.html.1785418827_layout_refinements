const list=document.getElementById("dealProfessionalList");if(!list)return;list.innerHTML="";const filtered=query?window.professionals.filter(p=>p.name.toLowerCase().includes(query.toLowerCase())):window.professionals;filtered.forEach(prof=>{const li=document.createElement("li");li.textContent=prof.name;li.onclick=()=>selectProfessional(prof);list.appendChild(li)})
}
function selectProfessional(prof){
document.getElementById("dealProfessionalId").value=prof.id;const chip=document.getElementById("dealProfessionalChip");chip.innerHTML=`<div class="chip">${escapeHtml(prof.name)} <span class="remove-chip" onclick="removeProfessional()">×</span></div>`;document.getElementById("dealProfessionalSearch").value="";document.getElementById("dealProfessionalList").innerHTML=""
    api("/api/crm/deals/" + dealId, { method: "PATCH", body: JSON.stringify({ professional_id: prof.id }) });
}
function removeProfessional(){
document.getElementById("dealProfessionalId").value="";document.getElementById("dealProfessionalChip").innerHTML="";document.getElementById("dealProfessionalSearch").value=""
    api("/api/crm/deals/" + dealId, { method: "PATCH", body: JSON.stringify({ professional_id: null }) });
}

async function _ensureUsersLoaded() {
  if (window._usersCache) return window._usersCache;
  try { const d = await api('/api/crm/ui/users'); window._usersCache = d.users || []; } catch (e) { window._usersCache = []; }
  return window._usersCache;
}
