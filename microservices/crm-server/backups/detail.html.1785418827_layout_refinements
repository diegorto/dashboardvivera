<script>
  let patientLabelsAvailable = [];
  let patientLabelsApplied = [];

  async function loadPatientLabels() {
    if (!currentDeal || !currentDeal.patient_id) return;
    try {
      const data = await api('/api/crm/patients/' + currentDeal.patient_id + '/labels');
      patientLabelsAvailable = data.available || [];
      patientLabelsApplied = data.applied || [];
      renderPatientLabelBar();
    } catch (e) { console.error('loadPatientLabels error:', e); }
  }

  function renderPatientLabelBar() {
    const bar = document.getElementById('patientLabelBar');
    const banner = document.getElementById('neverScheduleBanner');
    if (!bar) return;
    bar.innerHTML = patientLabelsAvailable.filter(function(l){ return l.name !== 'NUNCA AGENDAR'; }).map(function(l) {
      const active = patientLabelsApplied.indexOf(l.id) !== -1;
      const bg = active ? l.color : '#e5e7eb';
      const fg = active ? '#fff' : '#374151';
      return '<button class="patient-label-btn" data-id="' + l.id + '" style="background:' + bg + ';color:' + fg + ';border:none;border-radius:6px;padding:6px 12px;margin-right:6px;margin-bottom:6px;cursor:pointer;font-size:13px;font-weight:600;">' + escapeHtml(l.name) + '</button>';
    }).join('');
    const naLabel = patientLabelsAvailable.filter(function(l){ return l.name === 'NUNCA AGENDAR'; })[0];
    const naActive = naLabel && patientLabelsApplied.indexOf(naLabel.id) !== -1;
    if (banner) {
      if (naActive) {
        banner.style.display = 'block';
        banner.innerHTML = '<div style="background:#dc2626;color:#fff;padding:12px 16px;border-radius:8px;font-weight:800;font-size:15px;text-align:center;margin-top:10px;">🚨 NUNCA AGENDAR 🚨</div>';
      } else {
        banner.style.display = 'none';
        banner.innerHTML = '';
      }
    }
  }

  document.addEventListener('click', async function(e) {
    const btn = e.target.closest('.patient-label-btn');
    if (!btn || !currentDeal) return;
    const id = Number(btn.dataset.id);
    let newApplied;
    if (patientLabelsApplied.indexOf(id) !== -1) {
      newApplied = patientLabelsApplied.filter(function(x){ return x !== id; });
    } else {
      newApplied = patientLabelsApplied.concat([id]);
    }
    try {
      const resp = await api('/api/crm/patients/' + currentDeal.patient_id + '/labels', { method: 'PUT', body: JSON.stringify({ labelIds: newApplied }) });
      patientLabelsApplied = resp.labelIds || newApplied;
      renderPatientLabelBar();
      showToast('Etiquetas atualizadas.', 'success');
      await loadDeal();
    } catch (err) { showToast(err.message, 'error'); }
  });


  const STAGE_TAG_CONFIG = {
    14: { type: 'simple', options: [
      { tag: 'negociacao', label: 'Em negociacao', color: '#f59e0b' },
      { tag: 'semeando', label: 'Semeando relacionamento', color: '#eab308' },
      { tag: 'frio_incognita', label: 'Frio - incognita', color: '#64748b' }
    ]},
    15: { type: 'message', options: [
      { tag: 'resgate_msg1', label: 'Nao responde, tentando resgate - msg 1', color: '#ef4444' },
      { tag: 'resgate_msg2', label: 'Nao responde, tentando resgate - msg 2', color: '#dc2626' },
      { tag: 'resgate_msg3', label: 'Nao responde, tentando resgate - msg 3', color: '#b91c1c' }
    ]}
  };

  function renderStageTagBar() {
    const bar = document.getElementById('stageTagBar');
    if (!bar || !currentDeal) return;
    const cfg = STAGE_TAG_CONFIG[currentDeal.stage_id];
    if (!cfg) { bar.style.display = 'none'; bar.innerHTML = ''; return; }
    bar.style.display = 'block';
    bar.innerHTML = '<div style="display:flex;gap:8px;flex-wrap:wrap;">' + cfg.options.map(o => {
      const active = currentDeal.stage_tag === o.tag;
      return '<button class="stage-tag-btn" data-tag="' + o.tag + '" data-label="' + escapeHtml(o.label) + '" data-mode="' + cfg.type + '" style="background:' + o.color + ';color:#fff;border:none;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:13px;' + (active ? 'box-shadow:0 0 0 2px #111;' : '') + '">' + escapeHtml(o.label) + '</button>';
    }).join('') + '</div>';
  }

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.stage-tag-btn');
    if (!btn) return;
    const tag = btn.dataset.tag, label = btn.dataset.label, mode = btn.dataset.mode;
    if (mode === 'simple') {
      try {
        await api('/api/crm/deals/' + dealId + '/stage-tag', { method: 'PATCH', body: JSON.stringify({ tag, label }) });
        showToast('Etiqueta aplicada.', 'success');
        await loadDeal();
      } catch (err) { showToast(err.message, 'error'); }
    } else {
      openFollowupModal(tag, label);
    }
  });

  function openFollowupModal(tag, label) {
    const existing = document.getElementById('followupModal');
    if (existing) existing.remove();
    const modal = document.createElement('div');
    modal.id = 'followupModal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;';
    modal.innerHTML = '<div style="background:#fff;border-radius:8px;padding:20px;width:420px;max-width:90vw;">' +
      '<h3 style="margin:0 0 12px;">' + escapeHtml(label) + '</h3>' +
      '<p style="margin:0 0 8px;font-size:13px;color:#666;">Descreva o que foi enviado ao lead:</p>' +
      '<textarea id="followupMessageText" rows="5" style="width:100%;box-sizing:border-box;padding:8px;border:1px solid #ccc;border-radius:6px;"></textarea>' +
      '<div style="display:flex;justify-content:flex-end;gap:8px;margin-top:12px;">' +
      '<button id="followupCancelBtn" style="padding:6px 14px;">Cancelar</button>' +
      '<button id="followupConfirmBtn" style="padding:6px 14px;background:#6d5efc;color:#fff;border:none;border-radius:6px;">Confirmar</button>' +
      '</div></div>';
    document.body.appendChild(modal);
    document.getElementById('followupCancelBtn').onclick = () => modal.remove();
    document.getElementById('followupConfirmBtn').onclick = async () => {
      const message = document.getElementById('followupMessageText').value.trim();
      if (!message) { showToast('Escreva a mensagem enviada.', 'error'); return; }
      try {
        await api('/api/crm/deals/' + dealId + '/followup-message', { method: 'POST', body: JSON.stringify({ tag, label, message }) });
        showToast('Registrado no historico.', 'success');
        modal.remove();
        await loadDeal();
      } catch (err) { showToast(err.message, 'error'); }
    };
  }(function(){ try { var u = JSON.parse(localStorage.getItem('crm_user')||'null'); if (u && u.role === 'admin') { document.getElementById('sbAdminLabel').style.display=''; document.getElementById('sbAdminUsersLink').style.display=''; } } catch(e){} })();</script>
