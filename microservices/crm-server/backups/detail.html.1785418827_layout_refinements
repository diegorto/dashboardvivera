<script src="app.js"></script>
<script>
  requireAuth();
  const user = getUser();
  document.getElementById('userChip').textContent = user ? user.name : '';
  if (user && user.role === 'admin') { var _ddb = document.getElementById('deleteDealBtn'); if (_ddb) _ddb.style.display = 'inline-block'; }
  async function deleteDeal(){
    if (!confirm('Tem certeza que deseja excluir este negocio? Essa acao nao pode ser desfeita.')) return;
    try {
      await api('/api/crm/deals/' + dealId, { method: 'DELETE' });
      showToast('Negocio excluido.', 'success');
      window.location.href = 'index.html';
    } catch (e) {
      showToast(e.message, 'error');
    }
  }

  const dealId = qs('id');
  if (!dealId) window.location.href = 'index.html';

  let currentDeal = null;
  let campaignOptionsCache = [];
  let procedureOptionsCache = [];
  let allActivities = []; let currentHistory = [];
  let stagesByPipeline = {};
  let pipelinesList = [];
  let pendingStageId = null;
  let pendingPipelineSlug = null;

  document.querySelectorAll('.detail-section-head').forEach(head => {
    head.addEventListener('click', () => {
      document.getElementById(head.dataset.toggle).classList.toggle('collapsed');
    });
  });

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab' + btn.dataset.tab.charAt(0).toUpperCase() + btn.dataset.tab.slice(1)).classList.add('active');
    });
  });

  function renderActivityLists() {
    const manual = allActivities.filter(a => a.type !== 'stage_change' && a.type !== 'system');
    const el = document.getElementById('activityList');
    if (!manual.length) {
      el.innerHTML = '<span class="muted">Nenhuma atividade registrada.</span>';
    } else {
      el.innerHTML = manual.map(a => `
        <div class="activity-item">
          <div>${escapeHtml(a.content || a.type)}</div>
          <div class="activity-meta">${escapeHtml(a.user_name) || 'Sistema'} - <span class="activity-date-view" data-act-id="${a.id}" data-act-date="${a.created_at}">${fmtDateTime(a.due_at || a.created_at)}</span> <button type="button" class="activity-edit-date-btn" data-act-id="${a.id}" style="border:none;background:none;color:#6d5efc;cursor:pointer;font-size:12px;padding:0;">editar data</button>${!a.done ? '<button type="button" class="activity-done-btn" data-act-id="'+a.id+'" style="border:none;background:none;color:#16a34a;cursor:pointer;font-size:12px;padding:0;margin-left:8px;" title="Concluir">&#10003; Concluir</button>' : ''}<button type="button" class="activity-delete-btn" data-act-id="${a.id}" style="border:none;background:none;color:#e5484d;cursor:pointer;font-size:12px;padding:0;margin-left:8px;" title="Excluir atividade">🗑️</button></div>
        </div>
      `).join('');
    }

    const histEl = document.getElementById('historicoList');
  if (!currentHistory.length) {
    histEl.innerHTML = '<span class="muted">Nenhum registro no historico.</span>';
  } else {
    const HIST_LABELS = { lost: 'Perdido', won: 'Ganho', activity_scheduled: 'Atividade agendada', tag_applied: 'Etiqueta aplicada', followup_message: 'Mensagem de follow-up' };
    histEl.innerHTML = currentHistory.map(h => `
      <div class="activity-item">
        <div><strong>${escapeHtml(HIST_LABELS[h.event_type] || h.event_type)}</strong>${h.description ? ': ' + escapeHtml(h.description) : ''}</div>
        <div class="muted" style="font-size:12px;">${escapeHtml(h.user_name || '')} - ${fmtDateTime(h.created_at)}</div>
      </div>
    `).join('');
  }

  }

  function promptCallAnsweredNote() {
  return new Promise((resolve) => {
    const modal = document.getElementById('callAnsweredModal');
    const textarea = document.getElementById('callAnsweredNote');
    const cancelBtn = document.getElementById('callAnsweredCancelBtn');
    const confirmBtn = document.getElementById('callAnsweredConfirmBtn');
    textarea.value = '';
    modal.style.display = 'flex';
    setTimeout(() => textarea.focus(), 0);
    function cleanup(result) {
      modal.style.display = 'none';
      cancelBtn.removeEventListener('click', onCancel);
      confirmBtn.removeEventListener('click', onConfirm);
      resolve(result);
    }
    function onCancel() { cleanup(null); }
    function onConfirm() {
      const val = textarea.value.trim();
      if (!val) { showToast('Descreva o assunto da ligação antes de confirmar', 'error'); return; }
      cleanup(val);
    }
    cancelBtn.addEventListener('click', onCancel);
    confirmBtn.addEventListener('click', onConfirm);
  });
}
document.querySelectorAll('[data-quick-activity]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const label = btn.dataset.quickActivity;
          let callNote = null;
          if (label === 'Ligação Atendida') {
            callNote = await promptCallAnsweredNote();
            if (callNote === null) { return; }
          }
      const priorCount = (allActivities || []).filter(a => a.type === label).length;
      const ordLabel = (priorCount + 1) + 'ª ' + label;
          const activityContent = callNote ? (ordLabel + ' - ' + callNote) : ordLabel;
      try {
        let activityResp = await api('/api/crm/activities', { method: 'POST', body: JSON.stringify({ dealId: parseInt(dealId, 10), type: label, content: activityContent, done: true }) });
 if (activityResp && activityResp.possibleDuplicate) {
 const confirmedDup = window.confirm('Voce acabou de registrar essa mesma atividade, tem certeza que voce quer registrar novamente a mesma atividade?');
 if (!confirmedDup) { return; }
 activityResp = await api('/api/crm/activities', { method: 'POST', body: JSON.stringify({ dealId: parseInt(dealId, 10), type: label, content: activityContent, done: true, confirmDuplicate: true }) });
 }
 showToast('Atividade registrada: ' + ordLabel, 'success');
        const QUICK_ACT_STAGE_SKEY = { 'Agendou': 'agendamento', 'Compareceu': 'comparecimento', 'Faltou': 'nao-compareceu', 'Cancelou/Desmarcou': 'cancelou' };
        const targetSkey = QUICK_ACT_STAGE_SKEY[label];
        if (targetSkey && currentDeal) {
          const stagesHere = stagesByPipeline[currentDeal.pipeline_id] || [];
          const targetStage = stagesHere.find(function(s){ return s.skey === targetSkey; });
          if (targetStage && targetStage.id !== currentDeal.stage_id) {
            try {
              await api('/api/crm/deals/' + dealId + '/stage', { method: 'PATCH', body: JSON.stringify({ stageId: targetStage.id }) });
            } catch (stageErr) {
              showToast('Atividade registrada, mas nao foi possivel mover a etapa: ' + stageErr.message, 'error');
            }
          }
        }
        await loadDeal();
      } catch (err) {
        showToast(err.message, 'error');
      }
    });
  });

  const activityListEl = document.getElementById('activityList');
  if (activityListEl) {
    activityListEl.addEventListener('click', async (e) => {
      const doneBtn = e.target.closest('.activity-done-btn');
      if (doneBtn) {
        try {
          await api('/api/crm/activities/' + doneBtn.dataset.actId, { method: 'PATCH', body: JSON.stringify({ done: true }) });
          showToast('Atividade concluída.', 'success');
          await loadDeal();
        } catch (err) { showToast(err.message, 'error'); }
        return;
      }
      const delBtn = e.target.closest('.activity-delete-btn');
      if (!delBtn) return;
      if (!confirm('Tem certeza que deseja excluir esta atividade?')) return;
      try {
        await api('/api/crm/activities/' + delBtn.dataset.actId, { method: 'DELETE' });
        showToast('Atividade excluída', 'success');
        await loadDeal();
      } catch (err) {
        showToast(err.message, 'error');
      }
    });
  }

  document.addEventListener('click', async (e) => {
    const editBtn = e.target.closest('.activity-edit-date-btn');
    if (editBtn) {
      const id = editBtn.dataset.actId;
      const span = document.querySelector('.activity-date-view[data-act-id="' + id + '"]');
      if (!span || span.dataset.editing) return;
      span.dataset.editing = '1';
      const rawDate = span.dataset.actDate;
      const dt = new Date(rawDate);
      const pad = n => String(n).padStart(2, '0');
      const localValue = isNaN(dt) ? '' : `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}T${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
      const wrap = document.createElement('span');
      wrap.innerHTML = `<input type="datetime-local" class="input" style="display:inline-block;width:auto;padding:2px 6px;font-size:12px;" value="${localValue}"> <button type="button" class="btn" style="padding:2px 8px;font-size:12px;">salvar</button>`;
      span.replaceWith(wrap);
      wrap.querySelector('button').addEventListener('click', async () => {
        const newVal = wrap.querySelector('input').value;
        if (!newVal) return;
        try {
          await api('/api/crm/activities/' + id, { method: 'PATCH', body: JSON.stringify({ created_at: new Date(newVal).toISOString().slice(0,19).replace('T',' ') }) });
          showToast('Data da atividade atualizada.', 'success');
          await loadDeal();
        } catch (err) {
          showToast(err.message, 'error');
        }
      });
    }
  });


function renderProcedimentoOptions(selected) {
      const wrap = document.getElementById('dealProcedimento');
      if (!wrap) return;
      const selectedList = (selected || '').split(',').map(s => s.trim()).filter(Boolean);
      let opts = procedureOptionsCache.slice();
      selectedList.forEach(nm => { if (!opts.some(p => p.name === nm)) opts = [{ id: 'legacy', name: nm }, ...opts]; });
      wrap.innerHTML = opts.map(p => {
        const checked = selectedList.indexOf(p.name) !== -1 ? ' checked' : '';
        return '<label style="display:flex;align-items:center;gap:8px;padding:5px 2px;cursor:pointer;">' +
          '<input type="checkbox" value="' + escapeHtml(p.name) + '"' + checked + ' style="width:17px;height:17px;flex:none;">' +
          '<span>' + escapeHtml(p.name) + '</span></label>';
      }).join('');
    }
    function getSelectedProcedimentos() {
      const wrap = document.getElementById('dealProcedimento');
      if (!wrap) return '';
      return Array.from(wrap.querySelectorAll('input[type=checkbox]:checked')).map(o => o.value).join(', ');
    }

    document.getElementById('saveProcedimentosBtn').addEventListener('click', async () => {
      const btn = document.getElementById('saveProcedimentosBtn');
      btn.disabled = true;
      try {
        const procedimento = getSelectedProcedimentos();
        await api('/api/crm/deals/' + dealId, { method: 'PATCH', body: JSON.stringify({ procedimento }) });
        if (currentDeal) currentDeal.procedimento = procedimento;
        showToast('Procedimentos salvos.', 'success');
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        btn.disabled = false;
      }
    });

    document.getElementById('procedimentoNewToggle').addEventListener('click', (e) => {
    e.preventDefault();
    const wrap = document.getElementById('procedimentoNewWrap');
    wrap.style.display = wrap.style.display === 'none' ? '' : 'none';
  });
  document.getElementById('procedimentoNewSaveBtn').addEventListener('click', async () => {
    const name = document.getElementById('procedimentoNewInput').value.trim();
    if (!name) { showToast('Digite o nome do procedimento', 'error'); return; }
    try {
      const resp = await api('/api/crm/procedures', { method: 'POST', body: JSON.stringify({ name }) });
      if (!resp || resp.success === false) throw new Error((resp && resp.error) || 'Nao foi possivel cadastrar');
      procedureOptionsCache.push({ id: resp.id, name });
const already = getSelectedProcedimentos();
renderProcedimentoOptions(already ? already + ', ' + name : name);
      document.getElementById('procedimentoNewInput').value = '';
      document.getElementById('procedimentoNewWrap').style.display = 'none';
      showToast('Procedimento cadastrado: ' + name, 'success');
    } catch (err) {
      showToast(err.message, 'error');
    }
  });


  document.getElementById('addActivityBtn').addEventListener('click', async () => {
    const text = document.getElementById('newActivityText').value.trim();
    if (!text) return;
    try {
      await api('/api/crm/activities', {
        method: 'POST',
        body: JSON.stringify({ dealId: parseInt(dealId, 10), type: 'note', content: text })
      });
      document.getElementById('newActivityText').value = '';
      showToast('Atividade adicionada.', 'success');
      await loadDeal();
    } catch (err) {
      showToast(err.message, 'error');
    }
  });

  // ---- Breadcrumb / trocar funil e etapa ----
  document.getElementById('breadcrumbTrigger').addEventListener('click', () => {
    const pop = document.getElementById('stagePopover');
    const opening = pop.style.display === 'none';
    pop.style.display = opening ? 'block' : 'none';
    if (opening) {
      pendingPipelineSlug = pipelinesList.find(p => p.id === currentDeal.pipeline_id)?.slug || pipelinesList[0]?.slug;
      pendingStageId = currentDeal.stage_id;
      document.getElementById('pipelineSelect').value = pendingPipelineSlug;
      renderChevronStepper();
    }
  });

  document.getElementById('stageCancelBtn').addEventListener('click', () => {
    document.getElementById('stagePopover').style.display = 'none';
  });

  document.getElementById('pipelineSelect').addEventListener('change', (e) => {
    pendingPipelineSlug = e.target.value;
    const pipeline = pipelinesList.find(p => p.slug === pendingPipelineSlug);
    const stages = stagesByPipeline[pipeline.id] || [];
    pendingStageId = stages.length ? stages[0].id : null;
    renderChevronStepper();
  });

  function renderChevronStepper() {
    const pipeline = pipelinesList.find(p => p.slug === pendingPipelineSlug);
    const stages = (stagesByPipeline[pipeline.id] || []).slice().sort((a, b) => a.sort - b.sort);
    const currentIdx = stages.findIndex(s => s.id === pendingStageId);
    const stepper = document.getElementById('chevronStepper');
    stepper.innerHTML = stages.map((s, i) => `
      <div class="chevron-seg ${i < currentIdx ? 'filled' : ''} ${i === currentIdx ? 'current' : ''}" data-stage-id="${s.id}" title="${escapeHtml(s.label)}"></div>
    `).join('');
    stepper.querySelectorAll('.chevron-seg').forEach(seg => {
      seg.addEventListener('click', () => {
        pendingStageId = parseInt(seg.dataset.stageId, 10);
        renderChevronStepper();
      });
    });
    const cur = stages[currentIdx];
    document.getElementById('stageLabelCurrent').textContent = cur ? cur.label : '';
  }

  document.getElementById('stageSaveBtn').addEventListener('click', async () => {
    try {
      if (!pendingStageId) throw new Error('Selecione uma etapa');
      await api('/api/crm/deals/' + dealId + '/stage', {
        method: 'PATCH',
        body: JSON.stringify({ stageId: pendingStageId })
      });
      document.getElementById('stagePopover').style.display = 'none';
      showToast('Funil/etapa atualizados.', 'success');
      await loadDeal();
    } catch (err) {
      showToast(err.message, 'error');
    }
  });

  async function loadPipelines() {
    const data = await api('/api/crm/ui/pipelines');
    pipelinesList = data.pipelines;
    stagesByPipeline = {};
    data.stages.forEach(s => {
      if (!stagesByPipeline[s.pipeline_id]) stagesByPipeline[s.pipeline_id] = [];
      stagesByPipeline[s.pipeline_id].push(s);
    });
    const sel = document.getElementById('pipelineSelect');
    sel.innerHTML = pipelinesList.map(p => `<option value="${p.slug}">${escapeHtml(p.name)}</option>`).join('');
  }

  function updateBreadcrumb() {
    const pipeline = pipelinesList.find(p => p.id === currentDeal.pipeline_id);
    const stages = stagesByPipeline[currentDeal.pipeline_id] || [];
    const stage = stages.find(s => s.id === currentDeal.stage_id);
    document.getElementById('breadcrumbTrigger').textContent =
      (pipeline ? pipeline.name : '-') + ' → ' + (stage ? stage.label : '-');
  }

  // ---- Meta (motivos de perda + etiquetas do Pipedrive) ----
  let metaData = { lossReasons: [], labels: [] };
  const LABEL_COLORS = {
    green:'#10b981', red:'#ef4444', pink:'#ec4899', orange:'#f97316',
    'dark-gray':'#6b7280', brown:'#92400e', purple:'#8b5cf6', blue:'#3b82f6',
    yellow:'#eab308', gray:'#9ca3af', 'light-blue':'#38bdf8', 'dark-blue':'#1d4ed8',
    'light-green':'#86efac', 'dark-green':'#15803d'
  };

  async function loadMeta() {
    try {
      metaData = await api('/api/crm/ui/meta');
      const sel = document.getElementById('lossReasonSelect');
      sel.innerHTML = '<option value="">Selecione um motivo...</option>' +
        metaData.lossReasons.map(r => `<option value="${escapeHtml(r.label)}">${escapeHtml(r.label)}</option>`).join('');;
    sel.innerHTML += '<option value="__new__">+ Adicionar novo motivo...</option>';
    if (!sel.dataset.newBound) {
      sel.dataset.newBound = '1';
      sel.addEventListener('change', async function(){
        if (sel.value !== '__new__') return;
        const label = prompt('Nome do novo motivo de perda:');
        if (!label || !label.trim()) { sel.value = ''; return; }
        try {
          const resp = await api('/api/crm/ui/loss-reasons', { method: 'POST', body: JSON.stringify({ label: label.trim() }) });
          if (!resp || resp.success === false) throw new Error((resp && resp.error) || 'Nao foi possivel criar o motivo');
          metaData.lossReasons.push(resp.lossReason);
          const opt = document.createElement('option');
          opt.value = resp.lossReason.label;
          opt.textContent = resp.lossReason.label;
          const newOpt = sel.querySelector('option[value="__new__"]');
          sel.insertBefore(opt, newOpt);
          sel.value = resp.lossReason.label;
          showToast('Motivo criado: ' + resp.lossReason.label, 'success');
        } catch (err) {
          showToast(err.message, 'error');
          sel.value = '';
        }
      });
    }      const so = document.getElementById('dealOrigem');
      so.innerHTML = '<option value="">(Nenhum)</option>' +
        (metaData.origens || []).map(o => `<option value="${escapeHtml(o.label)}">${escapeHtml(o.label)}</option>`).join('');
        campaignOptionsCache = metaData.campanhas || [];
        try {
          const metaData2 = await api('/api/crm/meta');
          procedureOptionsCache = (metaData2 && metaData2.procedures) || [];
          renderProcedimentoOptions();
        } catch (e2) { /* procedures opcional */ }
    } catch (err) { /* meta opcional */ }
  }

  function currentTags() {
    const t = currentDeal.tags;
    if (Array.isArray(t)) return t.filter(Boolean);
    if (!t) return [];
    if (typeof t === 'string') {
      try { const arr = JSON.parse(t); if (Array.isArray(arr)) return arr.filter(Boolean); } catch (e) {}
      return t.split(',').map(s => s.trim()).filter(Boolean);
    }
    return [];
  }

  function renderLabelChip() {
    const chips = document.getElementById('labelChips');
    const chipsNegocio = document.getElementById('labelChipsNegocio');
    const tags = currentTags();
    const chipHtml = tags.map(t => {
      const lb = metaData.labels.find(l => l.name === t);
      const c = lb ? (LABEL_COLORS[lb.color] || '#9ca3af') : '#9ca3af';
      return `<span class="label-chip" style="background:${c};color:#fff;">${escapeHtml(t)}<span class="chip-remove-x" data-tag="${escapeHtml(t)}" title="Remover etiqueta" style="margin-left:6px;font-weight:700;cursor:pointer;">&times;</span></span>`;
    }).join('');
    chips.innerHTML = chipHtml;
    if (chipsNegocio) chipsNegocio.innerHTML = chipHtml;
    [chips, chipsNegocio].forEach(function(cont){
      if (!cont) return;
      cont.querySelectorAll('.chip-remove-x').forEach(function(x){
        x.addEventListener('click', async function(ev){
          ev.stopPropagation();
          var tag = x.dataset.tag;
          if (!confirm('Remover a etiqueta "' + tag + '"?')) return;
          try {
            var next = currentTags().filter(function(t){ return t !== tag; });
            await api('/api/crm/deals/' + dealId, { method: 'PATCH', body: JSON.stringify({ tags: JSON.stringify(next) }) });
            showToast('Etiqueta removida.', 'success');
            await loadDeal();
          } catch (err) { showToast(err.message, 'error'); }
        });
      });
    });
    document.getElementById('labelChip').textContent = 'Etiqueta';
    var _lc = document.getElementById('labelChip'); _lc.style.background = '#6366f1'; _lc.style.color = '#fff'; _lc.style.border = 'none';
  }

  let pendingLabels = new Set();

  function renderLabelList() {
    const q = document.getElementById('labelSearch').value.trim().toLowerCase();
    const list = document.getElementById('labelList');
