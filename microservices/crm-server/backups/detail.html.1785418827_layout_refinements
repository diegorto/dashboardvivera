  function renderDaysSinceContact() {
  var el = document.getElementById('daysSinceContact');
  if (!el) return;
  if (!allActivities || !allActivities.length) {
    el.textContent = 'Sem contato registrado';
    el.style.background = '#fee2e2';
    el.style.color = '#dc2626';
    return;
  }
  var maxDate = null;
  allActivities.forEach(function(a){
    var d = a.created_at ? new Date(a.created_at) : null;
    if (d && !isNaN(d.getTime()) && (!maxDate || d > maxDate)) maxDate = d;
  });
  if (!maxDate) { el.textContent = 'Sem contato registrado'; el.style.background = '#fee2e2'; el.style.color = '#dc2626'; return; }
  var days = Math.floor((Date.now() - maxDate.getTime()) / 86400000);
  el.textContent = days + (days === 1 ? ' dia sem contato' : ' dias sem contato');
  if (days >= 7) { el.style.background = '#fee2e2'; el.style.color = '#dc2626'; }
  else if (days >= 3) { el.style.background = '#fef3c7'; el.style.color = '#d97706'; }
  else { el.style.background = '#dcfce7'; el.style.color = '#16a34a'; }
}

