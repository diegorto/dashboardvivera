      const sel = ownerSelect.options[ownerSelect.selectedIndex];
      if (!sel) return;
      const newOwnerName = sel.textContent;
      const currentOwnerName = (currentDeal && currentDeal.owner_name) ? currentDeal.owner_name : 'sem dono';
      if (!confirm('Trocar o dono do negocio de "' + currentOwnerName + '" para "' + newOwnerName + '"?')) return;
      try {
        await api('/api/crm/deals/' + dealId + '/owner', { method: 'PATCH', body: JSON.stringify({ userId: parseInt(sel.value, 10) }) });
        showToast('Dono do negocio atualizado.', 'success');
        ownerPopover.style.display = 'none';
        await loadDeal();
      } catch (err) {
        showToast(err.message, 'error');
      }
    });
  }
});

