  const sel = document.getElementById('schedUser');
  sel.innerHTML = '';
  const users = await _ensureUsersLoaded();
  users.forEach(u => { const o = document.createElement('option'); o.value = u.id; o.textContent = u.name; sel.appendChild(o); });
  document.getElementById('schedType').value = 'Ligacao';
  document.getElementById('schedSubject').value = '';
  document.getElementById('schedDueAt').value = '';
  document.getElementById('scheduleActivityModal').style.display = 'flex';
});
document.addEventListener('DOMContentLoaded', function() {
const _schedCancelBtn = document.getElementById('schedCancelBtn');
if (_schedCancelBtn) {
  _schedCancelBtn.addEventListener('click', () => {
    document.getElementById('scheduleActivityModal').style.display = 'none';
  });
}
document.getElementById('schedSaveBtn')?.addEventListener('click', async () => {
  const type = document.getElementById('schedType').value;
  const subject = document.getElementById('schedSubject').value.trim();
  const dueAtLocal = document.getElementById('schedDueAt').value;
  const userId = parseInt(document.getElementById('schedUser').value, 10) || null;
  if (!subject) { showToast('Informe o assunto', 'error'); return; }
