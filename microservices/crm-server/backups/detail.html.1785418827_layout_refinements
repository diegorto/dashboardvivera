      dealId: parseInt(dealId, 10), type: type, subject: subject, content: subject,
      dueAt: new Date(dueAtLocal).toISOString().slice(0, 19).replace('T', ' '), assignedUserId: userId
    }) });
    showToast('Atividade agendada.', 'success');
    document.getElementById('scheduleActivityModal').style.display = 'none';
    await loadDeal();
  } catch (err) { showToast(err.message, 'error'); }
});
});
const _buscarTintimBtnEl = document.getElementById('buscarTintimBtn');
if (_buscarTintimBtnEl) {
  _buscarTintimBtnEl.addEventListener('click', async () => {
    const btn = _buscarTintimBtnEl;
