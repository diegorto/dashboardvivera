  document.getElementById('tintimNotFoundModal').style.display = 'none';
});

document.addEventListener('DOMContentLoaded', function() {
  const changeOwnerBtn = document.getElementById('changeOwnerBtn');
  const ownerPopover = document.getElementById('ownerPopover');
