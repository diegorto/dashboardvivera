<script>
function fmtTaskDotTooltip(status, dueAtRaw) {
  if (!dueAtRaw) return status === 'red' ? 'Tarefa atrasada' : 'Tarefa futura agendada';
  var d = new Date(dueAtRaw);
  if (isNaN(d.getTime())) return status === 'red' ? 'Tarefa atrasada' : 'Tarefa futura agendada';
  var pad = function(n){ return n < 10 ? '0'+n : ''+n; };
  var dstr = pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear();
  var tstr = pad(d.getHours()) + ':' + pad(d.getMinutes());
  if (status === 'red') return 'Tarefa atrasada desde ' + dstr + ' ' + tstr;
  return 'Tarefa agendada para ' + dstr + ' ' + tstr;
}
