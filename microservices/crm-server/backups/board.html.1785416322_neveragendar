<script>
  requireAuth();
  const user = getUser();
  document.getElementById('userChip').textContent = user ? user.name : '';

  const state = {
    sdr: '',
    pipelineSlug: qs('pipeline') || (user && user.role === 'recepcao' ? 'recepcao' : 'inbound'),
    data: null,
    search: '',
  };

  function cardMatchesSearch(deal) {
    if (state.sdr === '__unassigned__') { if ((deal.owner_name || '') !== '') return false; } else if (state.sdr && (deal.owner_name || '') !== state.sdr) return false;
    if (!state.search) return true;
    const s = state.search.toLowerCase();
    return (deal.patient_name || '').toLowerCase().includes(s) ||
           (deal.title || '').toLowerCase().includes(s) ||
           (deal.patient_phone || '').toLowerCase().includes(s) ||
           (deal.patient_email || '').toLowerCase().includes(s);
  }

  function renderPipelineTabs() {
    const el = document.getElementById('pipelineTabs');
    el.innerHTML = state.data.pipelines.map(p => `
      <div class="pipeline-tab ${p.slug === state.data.pipeline.slug ? 'active' : ''}" data-slug="${p.slug}">${escapeHtml(p.name)}</div>
    `).join('');
    el.querySelectorAll('.pipeline-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        state.pipelineSlug = tab.dataset.slug;
        const url = new URL(window.location.href);
        url.searchParams.set('pipeline', state.pipelineSlug);
        window.history.replaceState({}, '', url);
        loadBoard();
      });
    });
  }

  function ownerColorClass(name) {
    const n = (name || '').toLowerCase();
    if (n.indexOf('helenice') !== -1) return 'board-card-owner-helenice';
    if (n.indexOf('agda') !== -1) return 'board-card-owner-agda'; if (n.indexOf('hellen') !== -1) return 'board-card-owner-hellen';
    return '';
  }
  function formatLastReply(iso) {
        if (!iso) return 'nunca respondeu';
        const d = new Date(iso);
        return 'Respondeu: ' + d.toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
      }

      function formatElapsed(dateStr) {
    if (!dateStr) return '';
    const diffMs = Date.now() - new Date(dateStr).getTime();
    const diffHours = Math.floor(diffMs / 3600000);
    if (diffHours < 24) {
      const h = Math.max(0, diffHours);
      return h + ' hora' + (h === 1 ? '' : 's');
    }
    const d = Math.floor(diffMs / 86400000);
    return d + ' dia' + (d === 1 ? '' : 's');
  }
  function cardHtml(deal, col) {
    const rotting = col.rottingDays > 0 && deal.days_in_stage >= col.rottingDays;
    return `
      <div class="board-card ${ownerColorClass(deal.owner_name)} ${deal.reopened_lost_lead ? 'board-card-reopened' : ''}" style="${deal.reopened_lost_lead ? '' : (deal.duplicate_alert ? 'border:3px solid #9333ea;background:#f5f0ff;' : '')}" title="${deal.reopened_lost_lead ? 'Lead perdido que clicou novamente em campanha - retornou apos negocio anterior perdido. Confira o resumo na timeline.' : (deal.duplicate_alert ? 'Possivel duplicado - ja existe outro negocio aberto para este telefone. Revisar manualmente.' : '')}" draggable="true" data-deal-id="${deal.id}" data-stage-id="${deal.stage_id}">
        <div class="board-card-title">${escapeHtml(deal.title)}</div>
          ${(deal.labels||[]).some(l=>l.name==='CHECKED')?'<span style="display:inline-block;background:#16a34a;color:#fff;font-size:10px;font-weight:700;padding:1px 6px;border-radius:8px;margin:2px 0;">CHECKED</span>':''}
        ${deal.duplicate_alert ? '<span style="display:inline-block;background:#9333ea;color:#fff;font-size:10px;font-weight:700;padding:1px 6px;border-radius:8px;margin:2px 0;">⚠ POSSIVEL DUPLICADO</span>' : ''}
        ${deal.reopened_lost_lead ? '<span style="display:inline-block;background:#fff;color:#b91c1c;font-size:10px;font-weight:800;padding:1px 6px;border-radius:8px;margin:2px 0;">LEAD PERDIDO QUE CLICOU NOVAMENTE EM CAMPANHA</span>' : ''}${/* TASK_STATUS_DOT_UI */ (function(){ var s=deal.task_status; if(!s) return ''; var color = s==='red' ? '#dc2626' : '#22c55e'; var title = fmtTaskDotTooltip(s, deal.task_due_at); return '<span title="'+title+'" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:'+color+';margin-left:4px;vertical-align:middle;"></span>'; })()}${(function(){ var m={negociacao:['Em negociacao','#f59e0b'],semeando:['Semeando relacionamento','#eab308'],frio_incognita:['Frio - incognita','#64748b'],resgate_msg1:['Resgate msg 1','#ef4444'],resgate_msg2:['Resgate msg 2','#dc2626'],resgate_msg3:['Resgate msg 3','#b91c1c']}; var v=m[deal.stage_tag]; return v ? '<span style="display:inline-block;background:'+v[1]+';color:#fff;font-size:10px;font-weight:800;padding:2px 6px;border-radius:8px;margin-left:4px;">'+v[0]+'</span>' : ''; })()}
        <div class="board-card-patient">${escapeHtml(deal.patient_name)}${deal.patient_phone ? ' &middot; ' + escapeHtml(deal.patient_phone) : ''}</div>
        ${deal.owner_name ? '<div class="board-card-owner">' + escapeHtml(deal.owner_name) + '</div>' : ''}
        <div class="board-card-last-reply" style="font-size:11px;color:#888;margin-bottom:2px;">${formatLastReply(deal.last_inbound_at)}</div>
        <div class="board-card-total-days" style="font-size:11px;color:#888;margin-bottom:2px;">há ${formatElapsed(deal.add_date)}</div>
          <div class="board-card-foot">
          <span class="board-card-value">${fmtMoney(deal.value)}</span>
          <span class="${rotting ? 'board-card-rotting' : ''}">${formatElapsed(deal.stage_entered_at || deal.add_date)}</span>
        </div>
      </div>
    `;
  }

  function renderColumns() {
    const wrap = document.getElementById('boardWrap');
    wrap.innerHTML = state.data.columns.map(col => `
      <div class="board-col" data-stage-id="${col.id}">
        <div class="board-col-head">
          <div class="board-col-title">
            <span>${escapeHtml(col.label)}</span>
            <span class="board-col-count">${col.deals.length}</span>
          </div>
          <div class="board-col-value">${fmtMoney(col.totalValue)}</div>
        </div>
        <div class="board-col-body" data-stage-id="${col.id}">
          ${col.deals.filter(cardMatchesSearch).map(d => cardHtml(d, col)).join('')}
        </div>
      </div>
    `).join('');

    wrap.querySelectorAll('.board-card').forEach(card => {
      card.addEventListener('click', () => {
        window.location.href = 'detail.html?id=' + card.dataset.dealId;
      });
      card.addEventListener('dragstart', (e) => {
        e.dataTransfer.setData('text/plain', card.dataset.dealId);
        card.classList.add('dragging');
      });
      card.addEventListener('dragend', () => card.classList.remove('dragging'));
    });

    wrap.querySelectorAll('.board-col-body').forEach(colBody => {
      colBody.addEventListener('dragover', (e) => {
        e.preventDefault();
        colBody.closest('.board-col').classList.add('drag-over');
      });
      colBody.addEventListener('dragleave', () => {
        colBody.closest('.board-col').classList.remove('drag-over');
      });
      colBody.addEventListener('drop', async (e) => {
        e.preventDefault();
        colBody.closest('.board-col').classList.remove('drag-over');
        const dealId = e.dataTransfer.getData('text/plain');
        const targetStageId = parseInt(colBody.dataset.stageId, 10);
        try {
          await api('/api/crm/deals/' + dealId + '/stage', {
            method: 'PATCH',
            body: JSON.stringify({ stageId: targetStageId })
          });
          showToast('Negocio movido.', 'success');
          await loadBoard();
        } catch (err) {
          showToast(err.message, 'error');
        }
      });
    });
  }

  async function loadBoard() {
    try {
      const data = await api('/api/crm/board?pipeline=' + encodeURIComponent(state.pipelineSlug));
      state.data = data;
      document.getElementById('pipelineSub').textContent = data.pipeline.name;
      renderPipelineTabs();
      renderColumns();
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  document.getElementById('searchInput').addEventListener('input', (e) => {
    state.search = e.target.value.trim();
    if (state.data) renderColumns();
  });
  document.getElementById('sdrFilter').addEventListener('change', (e) => {
    state.sdr = e.target.value;
    if (state.data) renderColumns();
  });

  loadBoard();

function openNewDealModal(){
    ndSelectedPatient = null;
    document.getElementById('ndMode').value = 'existing';
    document.getElementById('ndExistingSearch').value = '';
    document.getElementById('ndExistingResults').innerHTML = '';
    document.getElementById('ndExistingResults').classList.remove('open');
    document.getElementById('ndSelectedInfo').textContent = '';
    document.getElementById('ndNewName').value = '';
    document.getElementById('ndNewPhone').value = '';
    document.getElementById('ndNewCountry').value = '55';
    document.getElementById('ndTitle').value = '';
    document.getElementById('ndValue').value = '';
    document.getElementById('ndPipeline').value = 'recepcao'; ndSelectedReferrer = null; document.getElementById('ndRefType').value = 'dia_a_dia'; document.getElementById('ndRefCampanhaSelect').value = ''; document.getElementById('ndRefCampanhaNew').value = ''; document.getElementById('ndRefCampanhaNew').style.display = 'none'; document.getElementById('ndRefCampanhaType').value = 'empresarial'; document.getElementById('ndReferrerSearch').value = ''; document.getElementById('ndReferrerResults').innerHTML = ''; document.getElementById('ndReferrerResults').classList.remove('open'); document.getElementById('ndReferrerInfo').textContent = ''; toggleIndicacaoFields();
    toggleNdMode();
    ndHidePhoneWarning();
ndSetupPhoneCheck();
document.getElementById('newDealOverlay').style.display = 'flex';
  }
  function closeNewDealModal(){ document.getElementById('newDealOverlay').style.display = 'none'; }
function toggleIndicacaoFields(){
  var pv = document.getElementById('ndPipeline').value;
  var block = document.getElementById('ndIndicacaoBlock');
  if (pv === 'indicacao') { block.style.display = 'block'; loadCampanhaOptions(); toggleRefType(); }
  else { block.style.display = 'none'; }
}
function toggleRefType(){
  var t = document.getElementById('ndRefType').value;
  document.getElementById('ndRefCampanhaBlock').style.display = t === 'campanha' ? 'block' : 'none';
  toggleRefPersonBlock();
}
function toggleRefPersonBlock(){
  var t = document.getElementById('ndRefType').value;
  var campType = document.getElementById('ndRefCampanhaType').value;
  var show = t === 'dia_a_dia' || (t === 'campanha' && campType === 'pessoa');
  document.getElementById('ndRefPersonBlock').style.display = show ? 'block' : 'none';
  document.getElementById('ndRefPersonLabel').textContent = t === 'dia_a_dia' ? 'Quem indicou? (buscar paciente)' : 'Quem indicou essa pessoa? (buscar paciente, para premiar depois)';
}
function toggleNewCampanhaInput(){
  var v = document.getElementById('ndRefCampanhaSelect').value;
  document.getElementById('ndRefCampanhaNew').style.display = v === '__new__' ? 'block' : 'none';
}
async function loadCampanhaOptions(){
  try {
    var data = await api('/api/crm/ui/meta');
    var sel = document.getElementById('ndRefCampanhaSelect');
    var campanhas = data.campanhas || [];
    var opts = ['<option value="">Selecione...</option>'].concat(campanhas.map(function(c){ return '<option value="' + escapeHtml(c.label) + '">' + escapeHtml(c.label) + '</option>'; })).concat(['<option value="__new__">+ Criar nova campanha</option>']);
    sel.innerHTML = opts.join('');
  } catch (e) { console.error('loadCampanhaOptions', e); }
}
document.addEventListener('DOMContentLoaded', function(){
  var inp = document.getElementById('ndReferrerSearch');
  if (inp) inp.addEventListener('input', function(){
    clearTimeout(ndReferrerSearchTimer);
    var q = inp.value.trim();
    ndReferrerSearchTimer = setTimeout(async function(){
      var box = document.getElementById('ndReferrerResults');
      if (!q) { box.classList.remove('open'); return; }
      var data = await api('/api/crm/patients?search=' + encodeURIComponent(q));
      var list = (data.patients || []).slice(0, 15);
      box.innerHTML = list.map(function(p){ return '<div data-id="' + p.id + '" data-name="' + escapeHtml(p.name) + '" data-phone="' + escapeHtml(p.phone||'') + '" onclick="selectNdReferrerFromEl(this)">' + escapeHtml(p.name) + (p.phone ? ' - ' + escapeHtml(p.phone) : '') + '</div>'; }).join('') || '<div class="muted" style="padding:8px;">Nenhum resultado</div>';
      box.classList.add('open');
    }, 300);
  });
});
function selectNdReferrerFromEl(el){ selectNdReferrer(el.dataset.id, el.dataset.name, el.dataset.phone); }
function selectNdReferrer(id, name, phone){
  ndSelectedReferrer = { id: id, name: name, phone: phone };
  document.getElementById('ndReferrerSearch').value = name;
  document.getElementById('ndReferrerResults').classList.remove('open');
  document.getElementById('ndReferrerInfo').textContent = 'Selecionado: ' + name;
}

  function toggleNdMode(){
    const mode = document.getElementById('ndMode').value;
    document.getElementById('ndExistingBlock').style.display = mode === 'existing' ? 'block' : 'none';
    document.getElementById('ndNewBlock').style.display = mode === 'new' ? 'block' : 'none';
if (mode !== 'new') { ndHidePhoneWarning(); }
  }
  let ndSearchTimer = null; let ndReferrerSearchTimer = null; let ndSelectedReferrer = null;
  document.addEventListener('DOMContentLoaded', function(){
    const inp = document.getElementById('ndExistingSearch');
    if (inp) inp.addEventListener('input', function(){
      clearTimeout(ndSearchTimer);
      const q = inp.value.trim();
      ndSearchTimer = setTimeout(async function(){
        const box = document.getElementById('ndExistingResults');
        if (!q) { box.classList.remove('open'); return; }
        const data = await api('/api/crm/patients?search=' + encodeURIComponent(q));
        const list = (data.patients || []).slice(0, 15);
        box.innerHTML = list.map(function(p){
          return '<div data-id="' + p.id + '" data-name="' + escapeHtml(p.name) + '" data-phone="' + escapeHtml(p.phone||'') + '" onclick="selectNdPatientFromEl(this)">' + escapeHtml(p.name) + ' - ' + escapeHtml(p.phone || 'sem telefone') + '</div>';
        }).join('') || '<div class="muted" style="padding:8px;">Nenhum resultado</div>';
        box.classList.add('open');
      }, 300);
    });
  });
  function selectNdPatientFromEl(el){
    selectNdPatient(el.dataset.id, el.dataset.name, el.dataset.phone);
  }
  function selectNdPatient(id, name, phone){
    ndSelectedPatient = { id: id, name: name, phone: phone };
    document.getElementById('ndExistingSearch').value = name;
    document.getElementById('ndSelectedInfo').textContent = 'Selecionado: ' + name + (phone ? ' (' + phone + ')' : ' (sem telefone cadastrado)');
    document.getElementById('ndExistingResults').classList.remove('open');
  }
  var ndPhoneCheckTimer = null;
var ndPhoneCheckLastQueried = '';
function ndSetupPhoneCheck(){
  var phoneInput = document.getElementById('ndNewPhone');
  if (!phoneInput || phoneInput.dataset.phoneCheckBound) return;
  phoneInput.dataset.phoneCheckBound = '1';
  phoneInput.addEventListener('blur', function(){ ndCheckPhoneDuplicate(); });
  phoneInput.addEventListener('input', function(){
    ndHidePhoneWarning();
    clearTimeout(ndPhoneCheckTimer);
    ndPhoneCheckTimer = setTimeout(function(){ ndCheckPhoneDuplicate(); }, 700);
  });
}
async function ndCheckPhoneDuplicate(){
  var modeEl = document.getElementById('ndMode');
  if (!modeEl || modeEl.value !== 'new') return;
  var countryEl = document.getElementById('ndNewCountry');
  var country = countryEl ? countryEl.value : '55';
  var digits = document.getElementById('ndNewPhone').value.replace(/\D/g, '');
  if (!digits || digits.length < 8) { ndHidePhoneWarning(); return; }
  var phone = '+' + country + digits;
  if (phone === ndPhoneCheckLastQueried) return;
  ndPhoneCheckLastQueried = phone;
  try {
    var resp = await api('/api/crm/ui/check-phone?phone=' + encodeURIComponent(phone));
    if (resp && resp.success && resp.exists) {
      ndShowPhoneWarning(resp);
    } else {
      ndHidePhoneWarning();
    }
  } catch (e) {
    console.error('check-phone falhou', e);
  }
}
function ndHidePhoneWarning(){
  var el = document.getElementById('ndPhoneWarning');
  if (el) el.style.display = 'none';
}
function ndDismissPhoneWarning(){
  ndHidePhoneWarning();
}
function ndOpenExistingDeal(dealId){
  if (!dealId) return;
  window.open('detail.html?id=' + dealId, '_blank');
}
function ndShowPhoneWarning(resp){
  var phoneInput = document.getElementById('ndNewPhone');
  if (!phoneInput) return;
  var el = document.getElementById('ndPhoneWarning');
  if (!el) {
    el = document.createElement('div');
    el.id = 'ndPhoneWarning';
    var fieldWrap = phoneInput.closest('.modal-field') || phoneInput.parentElement;
    if (fieldWrap && fieldWrap.parentElement) {
      fieldWrap.parentElement.insertBefore(el, fieldWrap.nextSibling);
    } else {
      phoneInput.insertAdjacentElement('afterend', el);
    }
  }
  var deals = resp.deals || [];
  var first = deals[0] || {};
  var nome = first.patientName || (resp.patients && resp.patients[0] && resp.patients[0].name) || 'paciente';
  var etapa = first.stage || '-';
  var statusLabel = first.status === 'open' ? 'aberto' : (first.status === 'closed' ? 'fechado' : (first.status || '-'));
  var dealId = first.id;
  el.style.cssText = 'margin-top:8px;padding:10px 12px;background:#fff3cd;border:1px solid #ffe08a;border-radius:8px;font-size:13px;color:#664d03;';
  el.innerHTML = '<div style="margin-bottom:8px;"><strong>Lead ja existe</strong> (' + escapeHtml(nome) + ', etapa atual: ' + escapeHtml(etapa) + ', ' + escapeHtml(statusLabel) + '). Quer conferir antes ou cadastrar um novo negocio mesmo assim?</div><div style="display:flex;gap:8px;"><button type="button" class="btn" onclick="ndOpenExistingDeal(' + Number(dealId) + ')">Ver cadastro existente</button><button type="button" class="btn" onclick="ndDismissPhoneWarning()">Cadastrar novo negocio mesmo assim</button></div>';
  el.style.display = 'block';
}
async function submitNewDeal(){
    const mode = document.getElementById('ndMode').value;
    let patientName, phone;
    if (mode === 'existing') {
      if (!ndSelectedPatient) { showToast('Selecione uma pessoa existente.', 'error'); return; }
      if (!ndSelectedPatient.phone) { showToast('Essa pessoa nao tem telefone cadastrado. Edite o cadastro dela ou use Nova pessoa.', 'error'); return; }
      patientName = ndSelectedPatient.name;
      phone = ndSelectedPatient.phone;
    } else {
      patientName = document.getElementById('ndNewName').value.trim();
      var ndCountry = document.getElementById('ndNewCountry').value;
      var ndPhoneDigits = document.getElementById('ndNewPhone').value.replace(/\D/g, '');
      if (!patientName) { showToast('Informe o nome.', 'error'); return; }
      if (!ndPhoneDigits) { showToast('Telefone e obrigatorio.', 'error'); return; }
      if (ndCountry === '55' && ndPhoneDigits.length !== 11) { showToast('Telefone deve ter DDD + 9 digitos (11 numeros).', 'error'); return; }
      phone = '+' + ndCountry + ndPhoneDigits;
    }
    const title = document.getElementById('ndTitle').value.trim();
    const value = document.getElementById('ndValue').value;
    try {
      const pipelineVal = document.getElementById('ndPipeline').value;
      var ndCampanhaToSend = null, ndCampaignTypeToSend = null, ndReferrerIdToSend = null;
      if (pipelineVal === 'indicacao') {
        var refType = document.getElementById('ndRefType').value;
        if (refType === 'campanha') {
          var campSel = document.getElementById('ndRefCampanhaSelect').value;
          if (campSel === '__new__') {
            var newLabel = document.getElementById('ndRefCampanhaNew').value.trim();
            if (!newLabel) { showToast('Informe o nome da nova campanha.', 'error'); return; }
            var created = await api('/api/crm/ui/campaign-options', { method: 'POST', body: JSON.stringify({ label: newLabel }) });
            campSel = created.campaign.label;
          }
          if (!campSel) { showToast('Selecione a campanha.', 'error'); return; }
          ndCampanhaToSend = campSel;
          ndCampaignTypeToSend = document.getElementById('ndRefCampanhaType').value;
          if (ndCampaignTypeToSend === 'pessoa') {
            if (!ndSelectedReferrer) { showToast('Selecione quem indicou.', 'error'); return; }
            ndReferrerIdToSend = ndSelectedReferrer.id;
          }
        } else {
          if (!ndSelectedReferrer) { showToast('Selecione quem indicou (indicacao do dia a dia).', 'error'); return; }
          ndReferrerIdToSend = ndSelectedReferrer.id;
        }
      }
      await api('/api/crm/deals', { method: 'POST', body: JSON.stringify({ patientName: patientName, phone: phone, title: title || patientName, value: value ? Number(value) : 0, pipeline: pipelineVal, campanha: ndCampanhaToSend, campaignType: ndCampaignTypeToSend, referrerPatientId: ndReferrerIdToSend }) });
      showToast('Negocio criado.', 'success');
      closeNewDealModal();
      loadBoard();
    } catch (e) {
      showToast(e.message, 'error');
    }
  }
