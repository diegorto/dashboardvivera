function fmtMoney(v){
  return 'R$ ' + Number(v||0).toLocaleString('pt-BR', {minimumFractionDigits:2, maximumFractionDigits:2});
}
async function loadWonDeals(){
  var sel = document.getElementById('wdRangeSel').value;
  var r = wdRangeDates(sel);
  var summaryEl = document.getElementById('wdSummary');
  var listEl = document.getElementById('wdList');
  summaryEl.textContent = 'Carregando...';
  listEl.innerHTML = '';
  try {
    var data = await api('/api/crm/deals/won-list?from=' + r.from + '&to=' + r.to);
    if (!data || !data.success) throw new Error((data && data.error) || "erro");
    summaryEl.textContent = data.count + ' negocio(s) ganho(s) - ' + fmtMoney(data.total);
    if (!data.deals.length) {
      listEl.innerHTML = '<p style="color:#888;">Nenhum negocio ganho no periodo.</p>';
    } else {
      listEl.innerHTML = data.deals.map(function(d){
        return '<div style="padding:10px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">' +
          '<div><a href="detail.html?id=' + d.id + '" target="_blank" style="color:#4f46e5;text-decoration:none;font-weight:600;">' + (d.patient_name||'') + '</a> <span style="background:#fee2e2;color:#b91c1c;font-size:11px;font-weight:600;padding:2px 6px;border-radius:4px;margin-left:4px;">' + (d.professional_name||'sem profissional registrado') + '</span><br><span style="color:#666;font-size:13px;">' + (d.procedure_name||d.title||'') + ' - ' + (d.owner_name||'') + '</span></div>' +
          '<div style="text-align:right;"><strong>' + fmtMoney(d.value) + '</strong><br><span style="color:#888;font-size:12px;">' + (d.won_date ? new Date(d.won_date).toLocaleDateString('pt-BR') : '') + '</span></div>' +
          '</div>';
      }).join('');
            var byProf = {};
            data.deals.forEach(function(d){
              var key = d.professional_name || 'sem profissional registrado';
              if (!byProf[key]) byProf[key] = { count: 0, total: 0 };
              byProf[key].count += 1;
              byProf[key].total += Number(d.value || 0);
            });
            var rankRows = Object.keys(byProf).map(function(k){ return { name: k, count: byProf[k].count, total: byProf[k].total }; });
            rankRows.sort(function(a, b){ return b.total - a.total; });
            var rankHtml = '<div style="margin-top:16px;padding-top:12px;border-top:2px solid #e5e7eb;">' +
              '<div style="font-weight:700;margin-bottom:8px;">Ranking por profissional</div>' +
              rankRows.map(function(r, i){
                return '<div style="display:flex;justify-content:space-between;padding:6px 0;font-size:14px;">' +
                  '<span>' + (i+1) + '. ' + r.name + ' <span style="color:#888;font-size:12px;">(' + r.count + ' negocio' + (r.count === 1 ? '' : 's') + ')</span></span>' +
                  '<strong>' + fmtMoney(r.total) + '</strong>' +
                '</div>';
              }).join('') +
            '</div>';
            listEl.innerHTML += rankHtml;
    }
  } catch (e) {
    summaryEl.textContent = 'Erro ao carregar.';
    showToast(e.message, 'error');
  }
}
document.getElementById('wdRangeSel').addEventListener('change', function(){
  var wrap = document.getElementById('wdCustomWrap');
  if (this.value === 'custom') { wrap.style.display = 'inline-flex'; }
