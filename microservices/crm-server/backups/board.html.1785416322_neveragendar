<script>
function wdRangeDatesFor(sel, fromId, toId){
  var now = new Date();
  var from, to;
  if (sel === 'today') { from = now; to = now; }
  else if (sel === 'yesterday') { var y = new Date(now.getTime() - 86400000); from = y; to = y; }
  else if (sel === 'week') { var day = now.getDay(); var diff = (day === 0 ? -6 : 1 - day); from = new Date(now); from.setDate(now.getDate() + diff); to = now; }
  else if (sel === 'lastweek') { var day2 = now.getDay(); var diff2 = (day2 === 0 ? -6 : 1 - day2); var thisMonday = new Date(now); thisMonday.setDate(now.getDate() + diff2); from = new Date(thisMonday); from.setDate(thisMonday.getDate() - 7); to = new Date(thisMonday); to.setDate(thisMonday.getDate() - 1); }
  else if (sel === 'month') { from = new Date(now.getFullYear(), now.getMonth(), 1); to = new Date(now.getFullYear(), now.getMonth()+1, 0); }
  else if (sel === 'lastmonth') { from = new Date(now.getFullYear(), now.getMonth()-1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); }
  else if (sel === 'custom') { var cf = document.getElementById(fromId); var ct = document.getElementById(toId); if (cf.value && ct.value) { return { from: cf.value, to: ct.value }; } from = now; to = now; }
  else { from = now; to = now; }
  var iso = function(d){ return d.toISOString().slice(0,10); };
  return { from: iso(from), to: iso(to) };
}
function wdRangeDates(sel){
  var now = new Date();
  var from, to;
  if (sel === 'today') { from = now; to = now; }
  else if (sel === 'yesterday') { var y = new Date(now.getTime() - 86400000); from = y; to = y; }
  else if (sel === 'week') { var day = now.getDay(); var diff = (day === 0 ? -6 : 1 - day); from = new Date(now); from.setDate(now.getDate() + diff); to = now; }
  else if (sel === 'lastweek') { var day2 = now.getDay(); var diff2 = (day2 === 0 ? -6 : 1 - day2); var thisMonday = new Date(now); thisMonday.setDate(now.getDate() + diff2); from = new Date(thisMonday); from.setDate(thisMonday.getDate() - 7); to = new Date(thisMonday); to.setDate(thisMonday.getDate() - 1); }
  else if (sel === 'month') { from = new Date(now.getFullYear(), now.getMonth(), 1); to = new Date(now.getFullYear(), now.getMonth()+1, 0); }
  else if (sel === 'lastmonth') { from = new Date(now.getFullYear(), now.getMonth()-1, 1); to = new Date(now.getFullYear(), now.getMonth(), 0); }
  else if (sel === 'custom') { var cf = document.getElementById('wdFrom'); var ct = document.getElementById('wdTo'); if (cf.value && ct.value) { return { from: cf.value, to: ct.value }; } from = now; to = now; }
  else { from = now; to = now; }
  var iso = function(d){ return d.toISOString().slice(0,10); };
  return { from: iso(from), to: iso(to) };
}
function openWonDealsModal(){
